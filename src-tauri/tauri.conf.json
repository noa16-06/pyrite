{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pyrite",
  "version": "0.1.0",
  "identifier": "dev.pyrite.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pyrite",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1E1F22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "noa16-06",
    "homepage": "https://github.com/noa16-06/pyrite",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 noa16-06",
    "shortDescription": "A fast, lightweight Python IDE",
    "longDescription": "Pyrite is a small Python IDE inspired by PyCharm: a project tree, a tabbed editor with Python highlighting, a run console that accepts stdin and links traceback lines, and an integrated terminal that activates the project's virtualenv.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "devel",
        "recommends": ["python3"],
        "desktopTemplate": "../packaging/linux/Pyrite.desktop",
        "files": {
          "/usr/share/metainfo/dev.pyrite.ide.metainfo.xml": "../packaging/linux/dev.pyrite.ide.metainfo.xml"
        }
      },
      "rpm": {
        "recommends": ["python3"],
        "desktopTemplate": "../packaging/linux/Pyrite.desktop",
        "files": {
          "/usr/share/metainfo/dev.pyrite.ide.metainfo.xml": "../packaging/linux/dev.pyrite.ide.metainfo.xml"
        }
      }
    }
  }
}
