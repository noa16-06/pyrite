# Maintainer: noa16-06
# Add your e-mail address to the line above before publishing this to the AUR.
#
# Arch builds from source and installs the files itself, so this does not go
# through Tauri's deb/rpm bundler — it reuses the same desktop entry, AppStream
# metadata and icons those bundles ship.
#
# Build and install locally with:  makepkg -si

pkgname=pyrite
pkgver=0.1.0
pkgrel=1
pkgdesc="A fast, lightweight Python IDE inspired by PyCharm"
arch=('x86_64' 'aarch64')
url="https://github.com/noa16-06/pyrite"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
makedepends=('rust' 'nodejs' 'npm')
optdepends=('python: run your code with the system interpreter')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real checksum once the tag is pushed: updpkgsums
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  npm ci
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # --no-bundle: package() installs the tree, so no .deb/.rpm is needed.
  npm run tauri -- build --no-bundle
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

  # Same file name the deb and rpm use, so the AppStream <launchable> matches.
  install -Dm644 packaging/linux/Pyrite.desktop \
    "$pkgdir/usr/share/applications/Pyrite.desktop"
  install -Dm644 packaging/linux/dev.pyrite.ide.metainfo.xml \
    "$pkgdir/usr/share/metainfo/dev.pyrite.ide.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  local size
  for size in 32 64 128 256; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$pkgname.png"
  done
  install -Dm644 src-tauri/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
}
